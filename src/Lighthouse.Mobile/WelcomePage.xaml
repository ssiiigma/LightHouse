<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Lighthouse.Mobile.ViewModels"
             xmlns:controls="clr-namespace:Lighthouse.Mobile.Controls"
             xmlns:loc="clr-namespace:Lighthouse.Mobile.Localization"
             x:Class="Lighthouse.Mobile.WelcomePage"
             x:DataType="vm:WelcomeViewModel"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <controls:LighthouseSceneDrawable x:Key="Scene" />
    </ContentPage.Resources>

    <Grid>
        <GraphicsView Drawable="{StaticResource Scene}" InputTransparent="True" />

        <Grid RowDefinitions="2*,Auto,5*,Auto" Padding="24,0,24,38">

            <VerticalStackLayout Grid.Row="1" HorizontalOptions="Center" Spacing="8">
                <Label Text="LIGHTHOUSE" HorizontalOptions="Center" FontFamily="CormorantLight"
                        FontSize="38" CharacterSpacing="4" LineBreakMode="NoWrap" MaxLines="1"
                        TextColor="{StaticResource Cream}" />
                <Label Text="{loc:Translate Welcome_Subtitle}" HorizontalOptions="Center"
                       FontFamily="DMSans" FontSize="11" CharacterSpacing="4"
                       TextColor="{StaticResource GoldLight}" />
                <Border Margin="0,16,0,0" Padding="20,10" StrokeThickness="0" BackgroundColor="#590A0E1A">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="40" />
                    </Border.StrokeShape>
                    <Label Text="{loc:Translate Welcome_Tagline}" HorizontalTextAlignment="Center"
                           FontFamily="CormorantLight" FontAttributes="Italic" FontSize="18"
                           TextColor="#F0E7D4" MaximumWidthRequest="270" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="3" Spacing="14">
                <Button Text="{loc:Translate Btn_CreateAccount}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding GoToRegisterCommand}" />
                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12">
                    <BoxView HeightRequest="1" Color="{StaticResource Dim}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{loc:Translate Welcome_Or}" Style="{StaticResource CaptionLabel}"
                           CharacterSpacing="2" />
                    <BoxView Grid.Column="2" HeightRequest="1" Color="{StaticResource Dim}" VerticalOptions="Center" />
                </Grid>
                <Button Text="{loc:Translate Btn_SignIn}" Style="{StaticResource SecondaryButton}"
                        Command="{Binding GoToLoginCommand}" />
            </VerticalStackLayout>

        </Grid>
    </Grid>
</ContentPage>