<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:Lighthouse.Mobile.ViewModels"
             xmlns:conv="clr-namespace:Lighthouse.Mobile.Converters"
             xmlns:controls="clr-namespace:Lighthouse.Mobile.Controls"
             xmlns:loc="clr-namespace:Lighthouse.Mobile.Localization"
             x:Class="Lighthouse.Mobile.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Style="{StaticResource TabPageStyle}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <conv:StringToBoolConverter x:Key="StringToBoolConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20,56,20,24" Spacing="14">

            <VerticalStackLayout Spacing="2">
                <Label Text="{loc:Translate Settings_Label}" Style="{StaticResource PageLabel}" TextTransform="Uppercase" />
                <Label Text="{loc:Translate Settings_Title}" Style="{StaticResource TitleLabel}" />
            </VerticalStackLayout>

                        <!-- Профіль -->
            <Border Style="{StaticResource CardBorder}" Padding="16">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border WidthRequest="56" HeightRequest="56" StrokeThickness="0" VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource Gold}" Offset="0" />
                                <GradientStop Color="#8B5A10" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Label Text="{Binding Initial}" FontFamily="DMSansSemibold" FontSize="22" TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="{Binding Name}" FontFamily="DMSansSemibold" FontSize="16"
                               LineBreakMode="TailTruncation" />
                        <Label Text="{Binding Email}" Style="{StaticResource SubtitleLabel}" FontSize="12"
                               LineBreakMode="TailTruncation" />
                        <Label Text="{Binding TimeZoneText}" Style="{StaticResource CaptionLabel}" />
                    </VerticalStackLayout>

                    <HorizontalStackLayout Grid.Column="2" Spacing="5" Padding="8,6" VerticalOptions="Start">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding EditNameCommand}" />
                        </HorizontalStackLayout.GestureRecognizers>
                        <Image Source="icon_edit.png" WidthRequest="13" HeightRequest="13" VerticalOptions="Center">
                            <Image.Behaviors>
                                <toolkit:IconTintColorBehavior TintColor="{StaticResource GoldLight}" />
                            </Image.Behaviors>
                        </Image>
                        <Label Text="{loc:Translate Profile_EditName}" FontSize="11" TextColor="{StaticResource GoldLight}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Grid>
            </Border>

            <!-- Категорії -->
            <Border Style="{StaticResource CardBorder}" Padding="16,14">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenCategoriesCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border WidthRequest="34" HeightRequest="34" StrokeThickness="0" BackgroundColor="#33805AD5">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Label Text="#" FontFamily="DMSansBold" FontSize="16" TextColor="#B79CFF"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Grid.Column="1" Text="{loc:Translate Cat_Manage}" FontFamily="DMSansMedium"
                           VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="›" FontSize="22" TextColor="{StaticResource GoldLight}"
                           VerticalOptions="Center" />
                </Grid>
            </Border>
            
            <!-- Резервні копії та дані -->
            <Border Style="{StaticResource CardBorder}" Padding="16,14">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenBackupsCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border WidthRequest="34" HeightRequest="34" StrokeThickness="0" BackgroundColor="#334CAF7D">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Label Text="↧" FontFamily="DMSansBold" FontSize="16" TextColor="#7BD9A5"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Grid.Column="1" Text="{loc:Translate Backup_Title}" FontFamily="DMSansMedium"
                           VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="›" FontSize="22" TextColor="{StaticResource GoldLight}"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Мова -->
            <Label Text="{loc:Translate Settings_Language}" Style="{StaticResource SectionLabel}" Margin="0,8,0,0" />
            <Border Style="{StaticResource CardBorder}" Padding="4" BackgroundColor="{StaticResource Card2}">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                    <Button Text="Українська" Style="{StaticResource SegmentButton}" Command="{Binding SetUkrainianCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsUkrainian}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource GoldLight}" />
                                <Setter Property="TextColor" Value="{StaticResource Navy}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="1" Text="English" Style="{StaticResource SegmentButton}" Command="{Binding SetEnglishCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsEnglish}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource GoldLight}" />
                                <Setter Property="TextColor" Value="{StaticResource Navy}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </Border>

            <!-- Сповіщення -->
            <Label Text="{loc:Translate Notif_Title}" Style="{StaticResource SectionLabel}" Margin="0,8,0,0" />
            <controls:NoticeView Text="{loc:Translate Notif_Blocked}" ActionText="{loc:Translate Btn_Allow}"
                                 ActionCommand="{Binding GrantNotificationsCommand}"
                                 IsVisible="{Binding NotificationsBlocked}" />
            <controls:NoticeView Text="{loc:Translate Notif_ExactBlocked}" ActionText="{loc:Translate Btn_Allow}"
                                 ActionCommand="{Binding GrantExactCommand}"
                                 IsVisible="{Binding ExactBlocked}" />
            <Border Style="{StaticResource CardBorder}" Padding="16,12">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{loc:Translate Notif_Tasks}" FontFamily="DMSansMedium" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding TaskRemindersOn}" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource Hairline}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{loc:Translate Notif_Habits}" FontFamily="DMSansMedium" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding HabitRemindersOn}" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource Hairline}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{loc:Translate Notif_Quiet}" FontFamily="DMSansMedium" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding QuietOn}" />
                    </Grid>
                    <VerticalStackLayout IsVisible="{Binding QuietOn}" Spacing="8">
                        <Label Text="{loc:Translate Notif_QuietFrom}" Style="{StaticResource CaptionLabel}" HorizontalOptions="Center" />
                        <controls:TimeInputView Time="{Binding QuietStart}" />
                        <Label Text="{loc:Translate Notif_QuietTo}" Style="{StaticResource CaptionLabel}" HorizontalOptions="Center" />
                        <controls:TimeInputView Time="{Binding QuietEnd}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
            <controls:NoticeView Text="{loc:Translate Notif_BatteryNote}" ActionText="{loc:Translate Btn_BatterySettings}"
                                 ActionCommand="{Binding OpenBatteryCommand}"
                                 IsVisible="{Binding BatteryRestricted}" />

            <!-- Синхронізація -->
            <Label Text="{loc:Translate Sync_Title}" Style="{StaticResource SectionLabel}" Margin="0,8,0,0" />
            <Border Style="{StaticResource CardBorder}" Padding="16,14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding SyncSummary}" FontFamily="DMSansMedium" FontSize="13" />
                    <Label Text="{Binding SyncDetail}" Style="{StaticResource CaptionLabel}"
                           IsVisible="{Binding SyncDetail, Converter={StaticResource StringToBoolConverter}}" />
                    <Button Text="{loc:Translate Sync_Now}" Command="{Binding SyncNowCommand}"
                            Style="{StaticResource GhostButton}" HorizontalOptions="Start" />
                    <Button Text="{loc:Translate Sync_Full}" Command="{Binding FullResyncCommand}"
                            Style="{StaticResource GhostButton}" HorizontalOptions="Start" />
                    <Button Text="{loc:Translate Sync_Retry}" Command="{Binding RetryParkedCommand}"
                            IsVisible="{Binding HasParked}" Style="{StaticResource GhostButton}" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <Button Text="{loc:Translate Btn_SignOut}" Style="{StaticResource DangerButton}" Margin="0,20,0,0"
                    Command="{Binding SignOutCommand}" />
            <Label Text="{loc:Translate App_Footer}" Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>