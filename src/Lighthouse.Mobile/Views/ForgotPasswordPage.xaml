<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Lighthouse.Mobile.ViewModels"
             xmlns:conv="clr-namespace:Lighthouse.Mobile.Converters"
             xmlns:controls="clr-namespace:Lighthouse.Mobile.Controls"
             xmlns:loc="clr-namespace:Lighthouse.Mobile.Localization"
             x:Class="Lighthouse.Mobile.Views.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <conv:StringToBoolConverter x:Key="StringToBoolConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="28,72,28,32" Spacing="14">

            <Label Text="LIGHTHOUSE" Style="{StaticResource PageLabel}" />
            <Label Text="{loc:Translate Forgot_Title}" Style="{StaticResource TitleLabel}" />
            <Label Text="{loc:Translate Forgot_Subtitle}" Style="{StaticResource SubtitleLabel}" Margin="0,0,0,12" />

            <controls:NoticeView Text="{Binding InfoMessage}" />

            <!-- Крок 1: адреса -->
            <VerticalStackLayout Spacing="14" IsVisible="{Binding IsStepOne}">
                <Border Style="{StaticResource FieldBorder}">
                    <Entry Placeholder="{loc:Translate Field_Email}" Keyboard="Email" Text="{Binding Email}" />
                </Border>
                <Button Text="{loc:Translate Forgot_Send}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SendCommand}" />
                <Button Text="{loc:Translate Forgot_HaveCode}" Style="{StaticResource GhostButton}"
                        Command="{Binding HaveCodeCommand}" />
            </VerticalStackLayout>

            <!-- Крок 2: код і новий пароль -->
            <VerticalStackLayout Spacing="14" IsVisible="{Binding IsStepTwo}">
                <Border Style="{StaticResource FieldBorder}">
                    <Entry Placeholder="{loc:Translate Forgot_CodePlaceholder}" Keyboard="Plain" Text="{Binding Token}" />
                </Border>
                <Border Style="{StaticResource FieldBorder}">
                    <Entry Placeholder="{loc:Translate Field_PasswordNew}" IsPassword="True" Text="{Binding NewPassword}" />
                </Border>
                <Border Style="{StaticResource FieldBorder}">
                    <Entry Placeholder="{loc:Translate Field_PasswordConfirm}" IsPassword="True" Text="{Binding ConfirmPassword}" />
                </Border>
                <Button Text="{loc:Translate Forgot_Reset}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ResetCommand}" />
                <Button Text="{loc:Translate Forgot_Resend}" Style="{StaticResource GhostButton}"
                        Command="{Binding BackToStepOneCommand}" />
            </VerticalStackLayout>

            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Red}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Button Text="{loc:Translate Btn_Back}" Style="{StaticResource GhostButton}" Command="{Binding GoBackCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>