<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===== Базові стилі ===== -->
    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource Navy}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Cream}" />
        <Setter Property="FontFamily" Value="DMSans" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource Cream}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Dim}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="DMSans" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{StaticResource Cream}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Dim}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="DMSans" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource Navy}" />
        <Setter Property="BackgroundColor" Value="{StaticResource GoldLight}" />
        <Setter Property="FontFamily" Value="DMSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource GoldLight}" />
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{StaticResource GoldLight}" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{StaticResource Gold}" />
        <Setter Property="ThumbColor" Value="{StaticResource Cream}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource Navy}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource GoldLight}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource Cream}" />
        <Setter Property="Shell.DisabledColor" Value="{StaticResource Dim}" />
        <Setter Property="Shell.UnselectedColor" Value="{StaticResource TabInactive}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource Navy}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource GoldLight}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource GoldLight}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource TabInactive}" />
    </Style>

    <!-- ===== Текстові стилі ===== -->
    <Style x:Key="TitleLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="DMSansBold" />
        <Setter Property="FontSize" Value="28" />
    </Style>

    <Style x:Key="PageLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Gold}" />
        <Setter Property="FontFamily" Value="DMSansSemibold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="2" />
    </Style>

    <Style x:Key="SubtitleLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Muted}" />
        <Setter Property="FontFamily" Value="DMSansSemibold" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="CharacterSpacing" Value="1.5" />
        <Setter Property="TextTransform" Value="Uppercase" />
    </Style>

    <Style x:Key="CaptionLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Dim}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- ===== Кнопки ===== -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource Navy}" />
        <Setter Property="BackgroundColor" Value="{StaticResource GoldLight}" />
        <Setter Property="FontFamily" Value="DMSansSemibold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="HeightRequest" Value="56" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource Cream}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Overlay}" />
        <Setter Property="BorderColor" Value="{StaticResource Muted}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontFamily" Value="DMSansMedium" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="HeightRequest" Value="56" />
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource GoldLight}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="DMSansMedium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeightRequest" Value="48" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource Red}" />
        <Setter Property="BackgroundColor" Value="#14E05C5C" />
        <Setter Property="BorderColor" Value="#40E05C5C" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontFamily" Value="DMSansSemibold" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="HeightRequest" Value="48" />
    </Style>

    <Style x:Key="SegmentButton" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource Muted}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="DMSansSemibold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="42" />
    </Style>

    <!-- ===== Контейнери ===== -->
    <Style x:Key="FieldBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Card2}" />
        <Setter Property="Stroke" Value="{StaticResource Hairline}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="14" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Card}" />
        <Setter Property="Stroke" Value="{StaticResource Hairline}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="20" />
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style TargetType="DatePicker">
        <Setter Property="TextColor" Value="{StaticResource Cream}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="DMSans" />
    </Style>

    <Style TargetType="TimePicker">
        <Setter Property="TextColor" Value="{StaticResource Cream}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="DMSans" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{StaticResource Cream}" />
        <Setter Property="TitleColor" Value="{StaticResource Dim}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="DMSans" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{StaticResource GoldLight}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Card2}" />
    </Style>

    <Style x:Key="ChipButton" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource Cream}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="FontFamily" Value="DMSansMedium" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="44" />
    </Style>

</ResourceDictionary>