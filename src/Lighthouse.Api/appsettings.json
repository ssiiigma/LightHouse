{
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "Lighthouse",
    "Audience": "Lighthouse.Mobile",
    "Secret": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Database": {
    "AutoMigrate": false
  },
  "Recommendations": {
    "ModelTrainingEnabled": true
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60,
    "ApiPermitLimit": 300,
    "ApiWindowSeconds": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
